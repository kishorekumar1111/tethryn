rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "kkmusiqyt@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().size() >= 3 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256;
    }

    function isValidTethra(data) {
      return data.keys().hasAll(['authorId', 'templateId', 'slug', 'recipientName', 'title', 'content', 'views', 'isPublished', 'createdAt', 'updatedAt']) &&
             data.authorId == request.auth.uid &&
             data.templateId is string && data.templateId.size() <= 128 &&
             data.slug is string && data.slug.size() <= 128 &&
             data.recipientName is string && data.recipientName.size() <= 256 &&
             data.title is string && data.title.size() <= 256 &&
             data.content is map &&
             data.views is number &&
             data.isPublished is bool &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 256));
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) &&
                    incoming().updatedAt == request.time;
    }

    // 2. Tethras Collection
    match /tethras/{tethraId} {
      allow get: if existing().isPublished == true || isOwner(existing().authorId);
      allow list: if isSignedIn() && (resource.data.isPublished == true || resource.data.authorId == request.auth.uid);
      
      allow create: if isSignedIn() && 
                    request.auth.token.email_verified == true &&
                    isValidId(tethraId) && 
                    isValidTethra(incoming()) && 
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      
      allow update: if isValidTethra(incoming()) && (
        // Action: Edit Content (Owner only)
        (isOwner(existing().authorId) && 
         request.auth.token.email_verified == true &&
         incoming().diff(existing()).affectedKeys().hasAny(['title', 'recipientName', 'senderName', 'slug', 'content', 'isPublished', 'updatedAt']) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'recipientName', 'senderName', 'slug', 'content', 'isPublished', 'updatedAt']) &&
         incoming().updatedAt == request.time) ||
        // Action: Increment Views (Anonymous/Public)
        (incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
         incoming().views == existing().views + 1)
      );
      
      allow delete: if isOwner(existing().authorId);
    }

    // 3. Templates Collection
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
