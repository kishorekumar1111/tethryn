rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "kkmusiqyt@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().size() >= 3 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256;
    }

    function isValidExperience(data) {
      return data.authorId is string &&
             data.authorId.size() <= 128 &&
             data.templateId is string &&
             data.slug is string &&
             data.title is string &&
             data.recipientName is string &&
             data.senderName is string &&
             data.content is map &&
             data.views is number &&
             data.isPublished is bool &&
             data.slug.size() <= 128 &&
             data.title.size() <= 200 &&
             data.recipientName.size() <= 200 &&
             data.senderName.size() <= 200;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                    isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt;
    }

    // 2. Experiences Collection
    match /experiences/{experienceId} {
      // Allow single document get (IDs are random/hard to guess)
      allow get: if true;
      
      // Secure list queries (Pillar 8)
      allow list: if 
        (resource.data.isPublished == true) || 
        (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));
      
      allow create: if isSignedIn() && 
                    isValidId(experienceId) && 
                    isValidExperience(incoming()) && 
                    incoming().authorId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      
      allow update: if isValidExperience(incoming()) && (
        // Action: Edit Content (Owner or Admin only)
        ((isOwner(existing().authorId) || isAdmin()) && 
         incoming().authorId == existing().authorId && // Immutability
         incoming().createdAt == existing().createdAt && // Immutability
         (incoming().diff(existing()).affectedKeys().hasAny(['templateId', 'title', 'recipientName', 'senderName', 'slug', 'content', 'isPublished', 'updatedAt']) || true) && // Workaround for hasAny
         incoming().diff(existing()).affectedKeys().hasOnly(['templateId', 'title', 'recipientName', 'senderName', 'slug', 'content', 'isPublished', 'updatedAt']) &&
         incoming().updatedAt == request.time) ||
        // Action: Increment Views (Anonymous/Public)
        (incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
         incoming().views == existing().views + 1)
      );
      
      allow delete: if isOwner(existing().authorId) || isAdmin();
    }

    // 3. Templates Collection
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
